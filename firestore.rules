rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ATS Candidates collection — allow read/write (Recruiter ATS)
    match /atsCandidates/{canId} {
      allow read, write: if true;
    }

    // ATS Jobs & Job Descriptions (JDs)
    match /atsJobs/{jobId} {
      allow read, write: if true;
    }

    // ATS Career Portal Applications
    match /atsApplications/{appId} {
      allow read, write: if true;
    }

    // ATS Requisitions (Potential Candidates & Requisition Data)
    match /atsRequisitions/{reqId} {
      allow read, write: if true;
    }

    // ATS Team Users & Hierarchy
    match /atsUsers/{userId} {
      allow read, write: if true;
    }

    // ATS Team & Candidate Messages
    match /atsMessages/{threadId} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
