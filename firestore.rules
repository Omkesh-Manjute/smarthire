rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ATS Candidates collection — allow read/write (no Firebase Auth required for ATS)
    // This is internal recruiter data, not public-facing
    match /atsCandidates/{canId} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
