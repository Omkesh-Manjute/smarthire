# VerifyHire Serverless API & Integration Settings

# Authentication Secret (Used to protect POST /api/automation/report)
# Send this in the "x-automation-secret" header of your requests
AUTOMATION_SECRET=your-super-secure-secret-key-change-this

# Airtable Configuration
# Personal Access Token with data.records:read and data.records:write scopes
AIRTABLE_PERSONAL_ACCESS_TOKEN=pat.xxx.yyy
AIRTABLE_BASE_ID=appxxxxxxxxx
AIRTABLE_TABLE_NAME=automation_reports
