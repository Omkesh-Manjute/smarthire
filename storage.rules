rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ATS candidate legal documents (Visa, DL, RTR, SSN, etc.)
    match /ats-documents/{canId}/{docKey}/{fileName} {
      allow read, write: if true;
    }

    // Public career portal candidate resumes
    match /ats-resumes/{jobId}/{candidateEmail}/{fileName} {
      allow read, write: if true;
    }

    // Allow general resume uploads
    match /resumes/{fileName} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
